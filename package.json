{
  "name": "dsh-wechat-reader",
  "version": "0.2.0",
  "description": "WeChat Official Account (mp.weixin.qq.com) article reader for DeepSeek Harness: fetches and parses article bodies into clean Markdown, with caching, retries and workspace-aware saving",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/parser.js": "./lib/parser.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "weixin",
    "wechat",
    "mp-weixin",
    "article",
    "reader",
    "markdown"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T34851969/dsh-wechat-reader.git"
  },
  "bugs": {
    "url": "https://github.com/T34851969/dsh-wechat-reader/issues"
  },
  "homepage": "https://github.com/T34851969/dsh-wechat-reader#readme",
  "author": "T34851969 (fork of dsh-weixin-reader by jack1545)",
  "license": "MIT"
}